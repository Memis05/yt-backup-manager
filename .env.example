# Optional development-only path overrides. Copy this template to the ignored .env file.
YTBM_ENVIRONMENT=development
YTBM_USER_DATA_PATH=
YTBM_LOCAL_DATA_PATH=
YTBM_DATABASE_PATH=
YTBM_LOG_LEVEL=info
# Google Desktop/Installed Application OAuth credentials. Never commit populated values.
YTBM_GOOGLE_OAUTH_CLIENT_ID=
YTBM_GOOGLE_OAUTH_CLIENT_SECRET=
